APP_ENV=development
DEBUG=false
SECRET_KEY=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CORS_ORIGINS=["http://localhost:5173"]

# Supported values: nvidia, openai, anthropic, test
AI_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=z-ai/glm-5.3
NVIDIA_STT_MODEL=cache-aware-parakeet-rnnt-en-US-asr-streaming-sortformer
NVIDIA_TTS_MODEL=magpie-tts-multilingual
NVIDIA_ASR_SERVER=grpc.nvcf.nvidia.com:443
NVIDIA_TTS_SERVER=grpc.nvcf.nvidia.com:443
NVIDIA_ASR_FUNCTION_ID=
NVIDIA_TTS_FUNCTION_ID=
NVIDIA_TTS_VOICE=Magpie-Multilingual.EN-US.Aria
NVIDIA_SPEECH_USE_SSL=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=3
AI_RETRY_BACKOFF_SECONDS=1.5

# Supabase Storage S3-compatible credentials
SUPABASE_STORAGE_ENDPOINT=
SUPABASE_STORAGE_REGION=ap-south-1
SUPABASE_STORAGE_ACCESS_KEY=
SUPABASE_STORAGE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=interview-resumes

REALTIME_SESSION_TTL_SECONDS=3600
REALTIME_AUDIO_MAX_CHUNK_BYTES=96000
REALTIME_MAX_AUDIO_SECONDS=300
REALTIME_MAX_EVENT_BYTES=262144
